<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC
    "-//NetBeans//DTD Filesystem 1.2//EN"
    "https://netbeans.org/dtds/filesystem-1_2.dtd">

<filesystem>

  <folder name="Templates">
    <folder name="Turtle">

      <attr
        name="SystemFileSystem.localizingBundle"
        stringvalue="art.cctcc.test.netbeans_mime_resolver.Bundle"/>

      <file name="TurtleTemplate.ttl" url="TurtleTemplate.ttl">
        <attr
          name="displayName"
          bundlevalue="art.cctcc.test.netbeans_mime_resolver.Bundle#Templates/Turtle/TurtleTemplate.ttl"/>
        <attr name="template" boolvalue="true"/>
      </file>

    </folder>
  </folder>

  <folder name="Editors">
    <folder name="text">
      <folder name="turtle">

        <attr
          name="SystemFileSystem.localizingBundle"
          stringvalue="art.cctcc.test.netbeans_mime_resolver.Bundle"/>

        <folder name="CodeTemplates">
          <file name="turtle-code-templates.xml"
                url="turtle-code-templates.xml"/>
        </folder>

      </folder>
    </folder>
  </folder>

</filesystem>